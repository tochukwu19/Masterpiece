<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- unless settings.type_body_font.system? and settings.type_heading_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless %}

    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif %}

    {% render 'meta-tags' %}

    {%- unless settings.type_body_font.system? %}
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless %}
    {%- unless settings.type_heading_font.system? %}
      {{ settings.type_heading_font | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: true }}
    {%- endunless %}

    {% render 'css-variables' %}
    {%- liquid
      assign legacy_templates = '404,article,blog,page' | split: ','
      assign legacy_styles = false
      if legacy_templates contains template.name or template.directory == 'customers'
        assign legacy_styles = true
      endif
    -%}
    {%- if legacy_styles -%}
      {{ 'application.css' | asset_url | stylesheet_tag }}
    {%- endif -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- if legacy_styles -%}
      {{ 'legacy-bridge.css' | asset_url | stylesheet_tag }}
    {%- endif -%}

    <script>
      window.theme = {
        locale: {{ request.locale.iso_code | json }},
        routes: {
          root_url: {{ routes.root_url | json }},
          cart_url: {{ routes.cart_url | json }},
          cart_add_url: {{ routes.cart_add_url | json }},
          cart_change_url: {{ routes.cart_change_url | json }},
          cart_update_url: {{ routes.cart_update_url | json }},
          search_url: {{ routes.search_url | json }},
          predictive_search_url: {{ routes.predictive_search_url | json }},
          product_recommendations_url: {{ routes.product_recommendations_url | json }}
        },
        settings: {
          cartType: {{ settings.cart_type | json }}
        },
        strings: {
          genericError: {{ 'general.errors.generic' | t | json }},
          cartItemRemoved: {{ 'cart.item_removed' | t | json }},
          linkCopied: {{ 'products.share.copied' | t | json }}
        }
      };
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'components.js' | asset_url }}" defer></script>
    <script src="{{ 'cart.js' | asset_url }}" defer></script>
    <script src="{{ 'product.js' | asset_url }}" defer></script>
    {%- if template.name == 'collection' or template.name == 'search' -%}
      <script src="{{ 'facets.js' | asset_url }}" defer></script>
    {%- endif -%}
    <script src="{{ 'alpine.min.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    {%- if settings.cart_type == 'drawer' and request.page_type != 'cart' -%}
      {% section 'cart-drawer' %}
    {%- endif %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
