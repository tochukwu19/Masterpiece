{% doc %}
  Global font faces and design tokens from theme settings.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{%- liquid
  assign heading_font = settings.type_heading_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bold'
  assign heading_font_italic = heading_font | font_modify: 'style', 'italic'

  assign body_font = settings.type_body_font
  assign body_font_medium = body_font | font_modify: 'weight', '500'
  assign body_font_bold = body_font | font_modify: 'weight', 'bold'
  assign body_font_italic = body_font | font_modify: 'style', 'italic'
  assign body_font_bold_italic = body_font_bold | font_modify: 'style', 'italic'
-%}

{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_bold | font_face: font_display: 'swap' }}
  {{ heading_font_italic | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_medium | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}
  {{ body_font_italic | font_face: font_display: 'swap' }}
  {{ body_font_bold_italic | font_face: font_display: 'swap' }}

  :root {
    --font-heading-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --font-heading-style: {{ heading_font.style }};
    --font-heading-weight: {{ heading_font.weight }};
    --font-heading-case: {{ settings.heading_case }};
    --font-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

    --font-body-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    --font-body-style: {{ body_font.style }};
    --font-body-weight: {{ body_font.weight }};
    --font-body-weight-medium: {% if body_font_medium %}500{% else %}{{ body_font.weight | plus: 100 }}{% endif %};
    --font-body-weight-bold: {% if body_font_bold %}700{% else %}{{ body_font.weight | plus: 300 | at_most: 900 }}{% endif %};
    --font-body-scale: {{ settings.body_scale | divided_by: 100.0 }};

    --page-width: {{ settings.page_width | divided_by: 16.0 }}rem;
    --spacing-sections: {{ settings.spacing_sections }}px;
    --grid-gap: {{ settings.spacing_grid }}px;

    --buttons-radius: {{ settings.buttons_radius }}px;
    --buttons-text-transform: {% if settings.buttons_uppercase %}uppercase{% else %}none{% endif %};
    --inputs-radius: {{ settings.inputs_radius }}px;

    {%- case settings.card_image_ratio -%}
      {%- when 'square' -%}
        --card-ratio: 1 / 1;
      {%- when 'landscape' -%}
        --card-ratio: 4 / 3;
      {%- when 'adapt' -%}
        --card-ratio: auto;
      {%- else -%}
        --card-ratio: 4 / 5;
    {%- endcase %}
    --media-zoom: {% if settings.animations_media_zoom %}1.05{% else %}1{% endif %};
  }

  {% for scheme in settings.color_schemes -%}
    {%- liquid
      assign s = scheme.settings
      assign background = s.background
      if s.background_gradient != blank
        assign background_image = s.background_gradient
      else
        assign background_image = 'none'
      endif
    -%}
    {% if forloop.first %}:root,{% endif %}
    .color-{{ scheme.id }} {
      --color-bg: {{ background }};
      --color-bg-image: {{ background_image }};
      --color-fg: {{ s.text }};
      --color-fg-rgb: {{ s.text.red }}, {{ s.text.green }}, {{ s.text.blue }};
      --color-accent: {{ s.accent }};
      --color-button: {{ s.button }};
      --color-button-label: {{ s.button_label }};
      --color-secondary-button-label: {{ s.secondary_button_label }};
      --color-fg-muted: color-mix(in srgb, var(--color-fg) 80%, var(--color-bg));
      --color-border: color-mix(in srgb, var(--color-fg) 18%, var(--color-bg));
      --color-border-input: color-mix(in srgb, var(--color-fg) 60%, var(--color-bg));
      --color-surface: color-mix(in srgb, var(--color-fg) 5%, var(--color-bg));
    }
  {% endfor %}

  {% for scheme in settings.color_schemes -%}
    .color-{{ scheme.id }}{% unless forloop.last %},{% endunless %}
  {%- endfor %} {
    background-color: var(--color-bg);
    background-image: var(--color-bg-image);
    color: var(--color-fg);
  }
{% endstyle %}
