{% doc %}
  Cart-level discounts, estimated total, tax and shipping note, optional note
  field and checkout button. Must sit inside an element with x-data="cart".

  @param {string} context - drawer or page
  @param {string} form_id - ID of the cart form the checkout button submits
  @example
  {% render 'cart-summary', context: 'drawer', form_id: 'CartForm-drawer' %}
{% enddoc %}

<div class="cart-summary">
  {%- if settings.cart_show_note -%}
    <details class="cart-summary__note disclosure" {% if cart.note != blank %}open{% endif %}>
      <summary class="cart-summary__note-toggle">
        {{ 'cart.note.toggle' | t }}
        {%- render 'icon', name: 'chevron-down' -%}
      </summary>
      <div class="field">
        <label class="visually-hidden" for="CartNote-{{ context }}">{{ 'cart.note.label' | t }}</label>
        <textarea
          id="CartNote-{{ context }}"
          class="textarea"
          name="note"
          form="{{ form_id }}"
          placeholder="{{ 'cart.note.placeholder' | t }}"
          x-on:change="saveNote($event.target.value)"
        >{{ cart.note }}</textarea>
      </div>
    </details>
  {%- endif -%}

  {%- if cart.cart_level_discount_applications.size > 0 -%}
    <ul class="cart-summary__discounts list-unstyled" role="list" aria-label="{{ 'cart.discounts' | t }}">
      {%- for discount in cart.cart_level_discount_applications -%}
        <li>
          <span>{{ discount.title }}</span>
          <span>&minus;{{ discount.total_allocated_amount | money }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  <div class="cart-summary__total">
    <span class="h5">{{ 'cart.estimated_total' | t }}</span>
    <span class="cart-summary__amount">{{ cart.total_price | money_with_currency }}</span>
  </div>

  <p class="cart-summary__taxes text-small text-muted">
    {%- if cart.duties_included and cart.taxes_included -%}
      {%- assign tax_key = 'cart.taxes.duties_and_taxes_included' -%}
    {%- elsif cart.taxes_included -%}
      {%- assign tax_key = 'cart.taxes.taxes_included' -%}
    {%- elsif cart.duties_included -%}
      {%- assign tax_key = 'cart.taxes.duties_included' -%}
    {%- else -%}
      {%- assign tax_key = 'cart.taxes.taxes_excluded' -%}
    {%- endif -%}
    {{ tax_key | t }}
    {%- if shop.shipping_policy.body != blank %}
      {{ 'cart.taxes.shipping_policy_html' | t: link: shop.shipping_policy.url }}
    {%- else %}
      {{ 'cart.taxes.shipping_at_checkout' | t }}
    {%- endif -%}
  </p>

  <button type="submit" name="checkout" form="{{ form_id }}" class="button button--full" {% if cart.item_count == 0 %}disabled{% endif %}>
    {{ 'cart.checkout' | t }}
  </button>
</div>

{% stylesheet %}
  .cart-summary {
    display: grid;
    gap: 1rem;
  }

  .cart-summary__note-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    font-weight: var(--font-body-weight-medium);
  }

  .cart-summary__note .field {
    margin-top: 0.5rem;
  }

  .cart-summary__note .textarea {
    min-height: 5.5rem;
  }

  .cart-summary__discounts {
    display: grid;
    gap: 0.25rem;
    font-size: calc(0.875rem * var(--font-body-scale));
  }

  .cart-summary__discounts li,
  .cart-summary__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .cart-summary__amount {
    font-size: calc(1.125rem * var(--font-body-scale));
    font-weight: var(--font-body-weight-medium);
    font-variant-numeric: tabular-nums;
  }

  .cart-summary__taxes a {
    color: inherit;
  }
{% endstylesheet %}
