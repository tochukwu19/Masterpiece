{% doc %}
  Art-directed image: an optional mobile image replaces the main image below 750px.

  @param {image} image - The main image
  @param {image} [mobile_image] - Image shown below 750px
  @param {string} [sizes] - The sizes attribute for the main image. Defaults to 100vw
  @param {boolean} [eager] - Load eagerly with high fetch priority
  @param {string} [class] - Class for the <img>
  @example
  {% render 'picture', image: section.settings.image, mobile_image: section.settings.image_mobile, eager: true %}
{% enddoc %}

{%- assign mobile_widths = '375,550,750,1100,1500' | split: ',' -%}

<picture>
  {%- if mobile_image -%}
    <source
      media="(max-width: 749px)"
      srcset="
        {%- for width in mobile_widths -%}
          {{ mobile_image | image_url: width: width }} {{ width }}w{% unless forloop.last %}, {% endunless %}
        {%- endfor -%}
      "
      sizes="100vw"
      width="{{ mobile_image.width }}"
      height="{{ mobile_image.height }}"
    >
  {%- endif -%}
  {%- render 'image', image: image, sizes: sizes, eager: eager, class: class -%}
</picture>
