{% doc %}
  Product or variant price with compare-at, unit price and sold-out state.

  @param {product} product - The product
  @param {variant} [variant] - A specific variant. When set, its price is shown instead of the product's lowest price
  @param {string} [class] - Extra classes for the wrapper
  @example
  {% render 'price', product: product %}
  {% render 'price', product: product, variant: product.selected_or_first_available_variant %}
{% enddoc %}

{%- liquid
  if variant
    assign target = variant
    assign amount = variant.price
    assign compare_amount = variant.compare_at_price
    assign available = variant.available
    assign show_from = false
  else
    assign target = product.selected_or_first_available_variant
    assign amount = product.price_min
    assign compare_amount = product.compare_at_price
    assign available = product.available
    assign show_from = product.price_varies
  endif

  assign on_sale = false
  if compare_amount > amount
    assign on_sale = true
  endif

  if settings.currency_code_enabled
    assign price_formatted = amount | money_with_currency
    assign compare_formatted = compare_amount | money_with_currency
  else
    assign price_formatted = amount | money
    assign compare_formatted = compare_amount | money
  endif
-%}

<div class="price{% if on_sale %} price--on-sale{% endif %}{% unless available %} price--sold-out{% endunless %} {{ class }}">
  {%- if on_sale -%}
    <span class="visually-hidden">{{ 'products.price.sale_price' | t }}</span>
    <span class="price__regular">
      {%- if show_from -%}
        {{- 'products.price.from_price_html' | t: price: price_formatted -}}
      {%- else -%}
        {{- price_formatted -}}
      {%- endif -%}
    </span>
    <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
    <s class="price__compare">{{ compare_formatted }}</s>
  {%- else -%}
    <span class="visually-hidden">{{ 'products.price.regular_price' | t }}</span>
    <span class="price__regular">
      {%- if show_from -%}
        {{- 'products.price.from_price_html' | t: price: price_formatted -}}
      {%- else -%}
        {{- price_formatted -}}
      {%- endif -%}
    </span>
  {%- endif -%}

  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      <span class="visually-hidden">{{ 'products.price.unit_price' | t }}</span>
      {{- target.unit_price | money -}}
      <span aria-hidden="true">/</span>
      <span class="visually-hidden">&nbsp;{{ 'general.accessibility.unit_price_separator' | t }}&nbsp;</span>
      {%- if target.unit_price_measurement.reference_value != 1 -%}
        {{- target.unit_price_measurement.reference_value -}}
      {%- endif -%}
      {{- target.unit_price_measurement.reference_unit -}}
    </span>
  {%- endif -%}
</div>
