{% doc %}
  Page card for search results: title and an excerpt on a surface panel.

  @param {page} page - The page
  @param {string} [heading_tag] - Title element. Defaults to h3
  @example
  {% render 'card-page', page: item %}
{% enddoc %}

{%- assign tag = heading_tag | default: 'h3' -%}

<article class="card-page">
  <p class="card-page__type eyebrow text-muted">{{ 'search.page_label' | t }}</p>
  <{{ tag }} class="card-page__title h4">
    <a href="{{ page.url }}" class="card-page__link">{{ page.title | escape }}</a>
  </{{ tag }}>
  {%- assign excerpt = page.content | strip_html | truncatewords: 30 -%}
  {%- if excerpt != blank -%}
    <p class="card-page__excerpt text-muted">{{ excerpt }}</p>
  {%- endif -%}
</article>

{% stylesheet %}
  .card-page {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    min-height: 100%;
    padding: clamp(1.25rem, 3vw, 2rem);
    background-color: var(--color-surface);
  }

  .card-page__type {
    margin: 0;
    font-size: 0.75rem;
  }

  .card-page__title,
  .card-page__excerpt {
    margin: 0;
  }

  .card-page__link {
    color: inherit;
    text-decoration: none;
  }

  .card-page__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-page:hover .card-page__link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }

  .card-page__link:focus-visible {
    outline: none;
  }

  .card-page__link:focus-visible::after {
    outline: 2px solid var(--color-fg);
    outline-offset: 3px;
  }
{% endstylesheet %}
