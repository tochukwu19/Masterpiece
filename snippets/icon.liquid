{% doc %}
  Inline SVG icon.

  @param {string} name - Icon name: account, arrow-left, arrow-right, bag, check,
    chevron-down, chevron-left, chevron-right, chevron-up, close, collapse, cube, error, expand,
    filter, menu, minus, pause, pin, play, plus, search, share, trash, volume, volume-off, zoom
  @param {string} [class] - Extra classes
  @example
  {% render 'icon', name: 'bag' %}
{% enddoc %}

<svg class="icon icon-{{ name }} {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
    {%- when 'arrow-left' -%}
      <path d="M20 12H4m6-6-6 6 6 6"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16m-6-6 6 6-6 6"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 8Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'error' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5m0 3.5v.01"/>
    {%- when 'filter' -%}
      <path d="M4 7h10m4 0h2M4 17h2m4 0h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>
    {%- when 'menu' -%}
      <path d="M3 9h18M3 15h18"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'cube' -%}
      <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>
    {%- when 'pin' -%}
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.5"/>
    {%- when 'play' -%}
      <path d="M8 5.5v13l10.5-6.5L8 5.5Z"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {%- when 'share' -%}
      <path d="M12 3v12m-4.5-7.5L12 3l4.5 4.5"/><path d="M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6m4-6v6"/>
    {%- when 'zoom' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5M11 8.5v5M8.5 11h5"/>
    {%- when 'pause' -%}
      <path d="M8 5.5v13M16 5.5v13"/>
    {%- when 'volume' -%}
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4v-5Z"/><path d="M15.5 9a4 4 0 0 1 0 6M18 6.5a7.5 7.5 0 0 1 0 11"/>
    {%- when 'volume-off' -%}
      <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4v-5Z"/><path d="m16 9.5 5 5m0-5-5 5"/>
    {%- when 'expand' -%}
      <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>
    {%- when 'collapse' -%}
      <path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"/>
  {%- endcase -%}
</svg>
