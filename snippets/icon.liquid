{% doc %}
  Inline SVG icon.

  @param {string} name - Icon name: account, arrow-left, arrow-right, bag, check,
    chevron-down, chevron-left, chevron-right, chevron-up, close, error, filter,
    menu, minus, plus, search, trash
  @param {string} [class] - Extra classes
  @example
  {% render 'icon', name: 'bag' %}
{% enddoc %}

<svg class="icon icon-{{ name }} {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'account' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/>
    {%- when 'arrow-left' -%}
      <path d="M20 12H4m6-6-6 6 6 6"/>
    {%- when 'arrow-right' -%}
      <path d="M4 12h16m-6-6 6 6-6 6"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l-1.2 12.2a1 1 0 0 1-1 .8H7.2a1 1 0 0 1-1-.8L5 8Z"/><path d="M9 10V6a3 3 0 0 1 6 0v4"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'chevron-left' -%}
      <path d="m15 6-6 6 6 6"/>
    {%- when 'chevron-right' -%}
      <path d="m9 6 6 6-6 6"/>
    {%- when 'chevron-up' -%}
      <path d="m6 15 6-6 6 6"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'error' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5m0 3.5v.01"/>
    {%- when 'filter' -%}
      <path d="M4 7h10m4 0h2M4 17h2m4 0h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>
    {%- when 'menu' -%}
      <path d="M3 9h18M3 15h18"/>
    {%- when 'minus' -%}
      <path d="M5 12h14"/>
    {%- when 'plus' -%}
      <path d="M12 5v14M5 12h14"/>
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>
    {%- when 'trash' -%}
      <path d="M4 7h16M9 7V4h6v3M6 7l1 13h10l1-13M10 11v6m4-6v6"/>
  {%- endcase -%}
</svg>
