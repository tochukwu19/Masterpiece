{% doc %}
  Country/region and language selectors. Submits on change; a fallback button
  shows without JS. Each selector only renders when there's more than one option.

  @param {string} id_prefix - Unique prefix for form and field IDs
  @param {boolean} [show_country] - Show the country/region selector
  @param {boolean} [show_language] - Show the language selector
  @param {boolean} [compact] - Inline style with hidden labels, for the header
  @example
  {% render 'localization-form', id_prefix: 'Footer', show_country: true, show_language: true %}
{% enddoc %}

{%- liquid
  assign country_enabled = false
  if show_country and localization.available_countries.size > 1
    assign country_enabled = true
  endif
  assign language_enabled = false
  if show_language and localization.available_languages.size > 1
    assign language_enabled = true
  endif
  if compact
    assign label_class = 'visually-hidden'
    assign select_class = 'select select--inline'
  else
    assign label_class = 'field__label'
    assign select_class = 'select'
  endif
  assign form_id = id_prefix | append: '-LocalizationForm'
-%}

{%- if country_enabled or language_enabled -%}
  <div class="localization{% if compact %} localization--compact{% endif %}" x-data x-on:change="$event.target.form.submit()">
    {%- form 'localization', id: form_id, class: 'localization__form' -%}
      {%- if country_enabled -%}
        <div class="field localization__field">
          <label class="{{ label_class }}" for="{{ id_prefix }}-Country">{{ 'localization.country_label' | t }}</label>
          <select id="{{ id_prefix }}-Country" class="{{ select_class }}" name="country_code">
            {%- for country in localization.available_countries -%}
              <option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>
                {{- country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol -}})
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
      {%- if language_enabled -%}
        <div class="field localization__field">
          <label class="{{ label_class }}" for="{{ id_prefix }}-Language">{{ 'localization.language_label' | t }}</label>
          <select id="{{ id_prefix }}-Language" class="{{ select_class }}" name="language_code">
            {%- for language in localization.available_languages -%}
              <option value="{{ language.iso_code }}" lang="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>
                {{- language.endonym_name | capitalize -}}
              </option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}
      <noscript>
        <button type="submit" class="button button--secondary">{{ 'localization.update' | t }}</button>
      </noscript>
    {%- endform -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .localization__form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 1rem;
  }

  .localization--compact .localization__form {
    gap: 0.5rem;
  }

  .localization--compact .select {
    max-width: 14rem;
    text-overflow: ellipsis;
  }
{% endstylesheet %}
