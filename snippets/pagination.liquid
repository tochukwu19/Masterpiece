{% doc %}
  Numbered pagination.

  @param {paginate} paginate - The paginate object from a {% paginate %} block
  @param {string} [anchor] - Fragment appended to page links, e.g. '#ProductGrid'
  @example
  {% render 'pagination', paginate: paginate, anchor: '#ProductGrid' %}
{% enddoc %}

{%- if paginate.pages > 1 -%}
  <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
    <ul class="pagination__list list-unstyled">
      <li>
        {%- if paginate.previous -%}
          <a href="{{ paginate.previous.url }}{{ anchor }}" class="pagination__item" rel="prev">
            {%- render 'icon', name: 'chevron-left' -%}
            <span class="visually-hidden">{{ 'general.pagination.previous' | t }}</span>
          </a>
        {%- else -%}
          <span class="pagination__item pagination__item--disabled" aria-hidden="true">
            {%- render 'icon', name: 'chevron-left' -%}
          </span>
        {%- endif -%}
      </li>

      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}{{ anchor }}" class="pagination__item">
              <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__item" aria-current="page">
              <span class="visually-hidden">{{ 'general.pagination.page' | t: number: part.title }}</span>
              <span aria-hidden="true">{{ part.title }}</span>
            </span>
          {%- else -%}
            <span class="pagination__item pagination__item--disabled">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}

      <li>
        {%- if paginate.next -%}
          <a href="{{ paginate.next.url }}{{ anchor }}" class="pagination__item" rel="next">
            {%- render 'icon', name: 'chevron-right' -%}
            <span class="visually-hidden">{{ 'general.pagination.next' | t }}</span>
          </a>
        {%- else -%}
          <span class="pagination__item pagination__item--disabled" aria-hidden="true">
            {%- render 'icon', name: 'chevron-right' -%}
          </span>
        {%- endif -%}
      </li>
    </ul>
  </nav>
{%- endif -%}
