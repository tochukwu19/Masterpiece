{% layout none %}
{%- assign initial_value = gift_card.initial_value | money_without_trailing_zeros | strip_html -%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{% render 'text-direction' %}">
  <head>
    <meta charset="utf-8">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    <meta name="robots" content="noindex">
    <title>{{ 'gift_cards.issued.title' | t: value: initial_value, shop: shop.name }}</title>
    <meta name="description" content="{{ 'gift_cards.issued.subtext' | t }}">

    {%- if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif %}

    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'component-gift-card.css' | asset_url | stylesheet_tag }}

    <script>
      window.theme = {
        strings: {
          codeCopied: {{ 'gift_cards.issued.copied' | t | json }},
          copyFailed: {{ 'gift_cards.issued.copy_failed' | t | json }}
        }
      };
    </script>
    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    <script src="{{ 'gift-card.js' | asset_url }}" defer></script>
    <script src="{{ 'alpine.min.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body>
    <main id="MainContent">
      {% section 'main-gift-card' %}
    </main>
  </body>
</html>
