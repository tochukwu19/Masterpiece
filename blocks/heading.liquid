<div class="block-heading" {{ block.shopify_attributes }}>
  {%- if block.settings.eyebrow != blank -%}
    <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
  {%- endif -%}
  {%- if block.settings.heading != blank -%}
    <h2 class="{{ block.settings.size }}">{{ block.settings.heading }}</h2>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:blocks.heading.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Made to be worn every day",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h0"
    }
  ],
  "presets": [
    {
      "name": "t:blocks.heading.name"
    }
  ]
}
{% endschema %}
