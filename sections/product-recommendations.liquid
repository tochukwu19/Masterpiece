{%- capture recommendations_url -%}
  {{- routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent -}}
{%- endcapture -%}

<div
  class="product-recommendations section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div
    class="page-width"
    data-recommendations="{{ section.id }}"
    {% unless recommendations.performed? %}
      data-recommendations-pending
    {% endunless %}
    x-data="recommendations('{{ recommendations_url }}', '{{ section.id }}')"
  >
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      <span data-recommendations-ready hidden></span>
      {%- render 'section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        size: section.settings.heading_size
      -%}
      <ul
        class="layout-grid list-unstyled"
        role="list"
        style="--cols: {{ section.settings.columns_desktop }}; --cols-tablet: {{ section.settings.columns_desktop | at_most: 3 }};"
      >
        {%- for recommendation in recommendations.products -%}
          <li>
            {%- render 'card-product', product: recommendation, id_prefix: section.id -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-recommendations [data-recommendations-pending] {
    min-height: clamp(26rem, 45vw, 34rem);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "class": "section-product-recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.product_recommendations.settings.paragraph.content"
    },
    {
      "type": "select",
      "id": "intent",
      "label": "t:sections.product_recommendations.settings.intent.label",
      "options": [
        {
          "value": "related",
          "label": "t:sections.product_recommendations.settings.intent.options__1.label"
        },
        {
          "value": "complementary",
          "label": "t:sections.product_recommendations.settings.intent.options__2.label"
        }
      ],
      "default": "related"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Related items",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "You may also like",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "t:sections.product_recommendations.settings.products_to_show.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.product_recommendations.settings.columns_desktop.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "t:sections.product_recommendations.presets.name"
    }
  ]
}
{% endschema %}
