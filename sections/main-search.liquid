{{ 'component-facets.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign terms = search.terms
  assign cols = section.settings.columns_desktop
  assign cols_tablet = cols | at_most: 3
  assign cols_mobile = section.settings.columns_mobile | plus: 0
  assign vw_desktop = 100 | divided_by: cols
  assign vw_tablet = 100 | divided_by: cols_tablet
  assign vw_mobile = 100 | divided_by: cols_mobile
  capture card_sizes
    echo '(min-width: 990px) ' | append: vw_desktop | append: 'vw, (min-width: 750px) ' | append: vw_tablet | append: 'vw, ' | append: vw_mobile | append: 'vw'
  endcapture

  assign filters_active = false
  for filter in search.filters
    if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
      assign filters_active = true
    endif
  endfor

  assign show_filters = false
  if section.settings.enable_filtering and search.filters.size > 0
    assign show_filters = true
  endif

  assign encoded_terms = terms | url_encode
  assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'
  if search.sort_by != blank and search.sort_by != search.default_sort_by
    assign clear_url = clear_url | append: '&sort_by=' | append: search.sort_by
  endif

  assign count_label = 'search.results_count' | t: count: search.results_count, terms: terms
  assign form_id = 'MainSearch-' | append: section.id
-%}

<div
  class="main-search section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
  x-data="facets('{{ section.id }}')"
  x-on:change="onChange($event)"
  x-on:submit="onSubmit($event)"
  x-on:click="onClick($event)"
  x-on:popstate.window="onPopState()"
>
  <div class="page-width">
    <div class="main-search__header">
      <h1 class="main-search__title {{ section.settings.heading_size }}">{{ 'search.title' | t }}</h1>
      {%- render 'search-form', id: form_id, suggestions: false -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results_count > 0 or filters_active -%}
        {%- render 'facets-toolbar',
          results: search,
          section_id: section.id,
          action: routes.search_url,
          clear_url: clear_url,
          count_label: count_label,
          show_filters: show_filters,
          show_sort: section.settings.enable_sorting,
          terms: terms
        -%}

        {%- if show_filters -%}
          {%- render 'facets',
            results: search,
            section_id: section.id,
            action: routes.search_url,
            clear_url: clear_url,
            results_count: search.results_count,
            terms: terms
          -%}
        {%- endif -%}
      {%- endif -%}

      <p class="visually-hidden" role="status" data-facets-status></p>

      {%- paginate search.results by section.settings.results_per_page -%}
        <div id="SearchResults-{{ section.id }}" class="main-search__results" data-facets-region="results">
          {%- if search.results.size > 0 -%}
            <ul
              class="layout-grid list-unstyled"
              role="list"
              style="--cols: {{ cols }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: {{ cols_mobile }};"
            >
              {%- for item in search.results -%}
                {%- liquid
                  assign eager = false
                  if forloop.index <= cols_mobile and paginate.current_page == 1
                    assign eager = true
                  endif
                -%}
                <li>
                  {%- case item.object_type -%}
                    {%- when 'product' -%}
                      {%- render 'card-product', product: item, sizes: card_sizes, eager: eager, id_prefix: section.id -%}
                    {%- when 'article' -%}
                      {%- render 'card-article', article: item, sizes: card_sizes, show_excerpt: false -%}
                    {%- when 'page' -%}
                      {%- render 'card-page', page: item -%}
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>
            {%- assign results_anchor = '#SearchResults-' | append: section.id -%}
            {%- render 'pagination', paginate: paginate, anchor: results_anchor -%}
          {%- elsif filters_active -%}
            <div class="main-search__empty">
              <p class="h3">{{ 'facets.no_matches.title' | t }}</p>
              <p class="text-muted">{{ 'facets.no_matches.text' | t }}</p>
              <a href="{{ clear_url }}" class="button button--secondary" data-facets-link>{{ 'facets.clear_all' | t }}</a>
            </div>
          {%- else -%}
            <div class="main-search__empty">
              <p class="h3">{{ 'search.no_results' | t: terms: terms }}</p>
              <p class="text-muted">{{ 'search.no_results_hint' | t }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .main-search__header {
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    text-align: center;
  }

  .main-search__title {
    margin: 0;
  }

  .main-search__header .search-form {
    text-align: start;
  }

  .main-search__results {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    transition: opacity var(--duration) ease;
  }

  .main-search .pagination {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .main-search__empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding-block: clamp(2rem, 6vw, 4rem);
    text-align: center;
  }

  .main-search__empty p {
    margin: 0;
  }

  .main-search__empty .button {
    margin-top: 0.75rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "class": "section-main-search",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "range",
      "id": "results_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 16,
      "label": "t:sections.main_search.settings.results_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main_collection.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_collection.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.header_filtering.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "info": "t:sections.main_search.settings.enable_filtering.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
