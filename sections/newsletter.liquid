{%- liquid
  assign image = section.settings.image
  assign form_id = 'Newsletter-' | append: section.id
-%}

<div
  class="newsletter banner{% if image %} banner--{{ section.settings.height }}{% endif %} section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="banner__frame">
    {%- if image -%}
      <div class="banner__media media">
        {%- render 'image', image: image, sizes: '100vw' -%}
        <span class="media-scrim"></span>
      </div>
    {%- endif -%}
    <div class="banner__content banner__content--center-center page-width">
      <div class="newsletter__content content-stack content-stack--center{% if image %} on-media{% endif %}">
        <div class="block-heading">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.text != blank -%}
          <div class="block-text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        <div class="newsletter__form">
          {%- render 'newsletter-form', id: form_id -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .newsletter__content {
    --content-width: 36rem;
  }

  .newsletter__form {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.newsletter.name",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Newsletter",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Stay in the loop",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>New collections, restocks and the occasional private sale. No spam.</p>",
      "label": "t:blocks.text.settings.text.label"
    },
    {
      "type": "header",
      "content": "t:sections.collection_banner.settings.header_image.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.newsletter.settings.image.label",
      "info": "t:sections.newsletter.settings.image.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25,
      "label": "t:sections.hero.settings.overlay_opacity.label"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.settings.height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.hero.settings.height.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.hero.settings.height.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.hero.settings.height.options__3.label"
        },
        {
          "value": "full",
          "label": "t:sections.hero.settings.height.options__4.label"
        }
      ],
      "default": "medium"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter.presets.name"
    }
  ]
}
{% endschema %}
