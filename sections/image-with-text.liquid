{%- liquid
  assign image = section.settings.image
  assign ratio = section.settings.image_ratio
  if ratio == 'adapt'
    if image
      assign ratio = image.aspect_ratio
    else
      assign ratio = '4 / 5'
    endif
  endif
-%}

<div
  class="image-with-text section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="image-with-text__inner image-with-text__inner--{{ section.settings.image_position }} page-width" style="--align: {{ section.settings.vertical_alignment }};">
    <div class="image-with-text__media media" style="--ratio: {{ ratio }};">
      {%- if image -%}
        {%- render 'image', image: image, sizes: '(min-width: 750px) 50vw, 100vw' -%}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="image-with-text__content content-stack">
      {%- content_for 'blocks' -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: var(--align, center);
  }

  @media (min-width: 750px) {
    .image-with-text__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .image-with-text__inner--right .image-with-text__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "section-image-with-text",
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_with_text.settings.image.label"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.image_with_text.settings.image_position.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.image_with_text.settings.image_position.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.image_with_text.settings.image_position.options__2.label"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.image_with_text.settings.image_ratio.label",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.image_with_text.settings.image_ratio.options__1.label"
        },
        {
          "value": "4 / 5",
          "label": "t:sections.image_with_text.settings.image_ratio.options__2.label"
        },
        {
          "value": "1 / 1",
          "label": "t:sections.image_with_text.settings.image_ratio.options__3.label"
        },
        {
          "value": "3 / 2",
          "label": "t:sections.image_with_text.settings.image_ratio.options__4.label"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:sections.image_with_text.settings.vertical_alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:sections.image_with_text.settings.vertical_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.image_with_text.settings.vertical_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:sections.image_with_text.settings.vertical_alignment.options__3.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_with_text.presets.name",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "eyebrow": "Craft",
            "heading": "Finished by hand",
            "size": "h1"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Pair a photo with a short story about a collection, a material or the people who make your pieces.</p>"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "Learn more",
            "style": "secondary"
          }
        }
      },
      "block_order": [
        "heading",
        "text",
        "button"
      ]
    }
  ]
}
{% endschema %}
