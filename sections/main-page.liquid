<div
  class="main-page section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="main-page__inner main-page__inner--{{ section.settings.width }} main-page__inner--{{ section.settings.alignment }} page-width">
    <h1 class="main-page__title {{ section.settings.heading_size }}">{{ page.title | escape }}</h1>
    {%- if page.content != blank -%}
      <div class="main-page__content rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .main-page__inner {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .main-page__inner--narrow {
    --content-width: 44rem;
  }

  .main-page__inner--wide {
    --content-width: 64rem;
  }

  .main-page__title,
  .main-page__content {
    width: min(100%, var(--content-width));
  }

  .main-page__title {
    overflow-wrap: anywhere;
  }

  .main-page__inner--center {
    justify-items: center;
  }

  .main-page__inner--center .main-page__title {
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_page.name",
  "class": "section-main-page",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h0"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:sections.all.alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.alignment.options__2.label"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:sections.main_page.settings.width.label",
      "options": [
        {
          "value": "narrow",
          "label": "t:sections.main_page.settings.width.options__1.label"
        },
        {
          "value": "wide",
          "label": "t:sections.main_page.settings.width.options__2.label"
        }
      ],
      "default": "narrow"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 48,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
