<div
  class="editorial-split banner banner--{{ section.settings.height }} section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <ul class="editorial-split__panels list-unstyled" role="list">
    {%- for block in section.blocks -%}
      {%- assign image = block.settings.image -%}
      <li class="editorial-split__panel banner__frame" {{ block.shopify_attributes }}>
        <div class="banner__media media">
          {%- if image -%}
            {%- render 'image', image: image, sizes: '(min-width: 750px) 50vw, 100vw' -%}
            <span class="media-scrim"></span>
          {%- else -%}
            {%- assign illustration = forloop.index | modulo: 2 | plus: 1 | prepend: 'collection-' -%}
            {{ illustration | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <div class="banner__content banner__content--bottom-center">
          <div class="content-stack content-stack--center{% if image %} on-media{% endif %}">
            <div class="block-heading">
              {%- if block.settings.eyebrow != blank -%}
                <p class="eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <h2 class="{{ section.settings.heading_size }}">{{ block.settings.heading }}</h2>
              {%- endif -%}
            </div>
            {%- if block.settings.button_label != blank -%}
              <a
                {% if block.settings.link != blank %}
                  href="{{ block.settings.link }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
                class="block-button button button--secondary"
              >
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</div>

{% stylesheet %}
  .editorial-split__panels {
    display: grid;
  }

  @media (min-width: 750px) {
    .editorial-split__panels {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.editorial_split.name",
  "class": "section-editorial-split",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "panel",
      "name": "t:sections.editorial_split.blocks.panel.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.image_with_text.settings.image.label",
          "info": "t:sections.editorial_split.blocks.panel.settings.image.info"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "t:sections.all.eyebrow.label"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Rings",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Shop now",
          "label": "t:blocks.button.settings.label.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:blocks.button.settings.link.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.settings.height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.hero.settings.height.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.hero.settings.height.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.hero.settings.height.options__3.label"
        },
        {
          "value": "full",
          "label": "t:sections.hero.settings.height.options__4.label"
        }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 25,
      "label": "t:sections.hero.settings.overlay_opacity.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h0"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.editorial_split.presets.name",
      "blocks": {
        "panel_1": {
          "type": "panel",
          "settings": {
            "heading": "Rings",
            "eyebrow": "Shop"
          }
        },
        "panel_2": {
          "type": "panel",
          "settings": {
            "heading": "Necklaces",
            "eyebrow": "Shop"
          }
        }
      },
      "block_order": [
        "panel_1",
        "panel_2"
      ]
    }
  ]
}
{% endschema %}
