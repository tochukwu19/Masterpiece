{%- liquid
  assign image = section.settings.image
  assign position = section.settings.content_position
  assign horizontal = position | split: '-' | last
  assign eager = false
  if section.index <= 2
    assign eager = true
  endif
-%}

<div
  class="hero banner banner--{{ section.settings.height }} section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px; --overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"
>
  <div class="banner__frame">
    <div class="banner__media media">
      {%- if image -%}
        {%- render 'picture', image: image, mobile_image: section.settings.image_mobile, eager: eager -%}
        <span class="media-scrim"></span>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>

    <div class="banner__content banner__content--{{ position }} page-width">
      <div class="content-stack content-stack--{{ horizontal }}{% if image %} on-media{% endif %}">
        {%- content_for 'blocks' -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "class": "section-hero",
  "blocks": [
    {
      "type": "heading"
    },
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "custom-liquid"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.hero.settings.image.label",
      "info": "t:sections.hero.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.hero.settings.image_mobile.label",
      "info": "t:sections.hero.settings.image_mobile.info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30,
      "label": "t:sections.hero.settings.overlay_opacity.label"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:sections.hero.settings.height.label",
      "options": [
        {
          "value": "small",
          "label": "t:sections.hero.settings.height.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.hero.settings.height.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.hero.settings.height.options__3.label"
        },
        {
          "value": "full",
          "label": "t:sections.hero.settings.height.options__4.label"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "t:sections.hero.settings.content_position.label",
      "options": [
        {
          "value": "top-left",
          "label": "t:sections.hero.settings.content_position.options__1.label"
        },
        {
          "value": "top-center",
          "label": "t:sections.hero.settings.content_position.options__2.label"
        },
        {
          "value": "top-right",
          "label": "t:sections.hero.settings.content_position.options__3.label"
        },
        {
          "value": "center-left",
          "label": "t:sections.hero.settings.content_position.options__4.label"
        },
        {
          "value": "center-center",
          "label": "t:sections.hero.settings.content_position.options__5.label"
        },
        {
          "value": "center-right",
          "label": "t:sections.hero.settings.content_position.options__6.label"
        },
        {
          "value": "bottom-left",
          "label": "t:sections.hero.settings.content_position.options__7.label"
        },
        {
          "value": "bottom-center",
          "label": "t:sections.hero.settings.content_position.options__8.label"
        },
        {
          "value": "bottom-right",
          "label": "t:sections.hero.settings.content_position.options__9.label"
        }
      ],
      "default": "center-center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "info": "t:sections.hero.settings.color_scheme.info",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.presets.name",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "eyebrow": "New season",
            "heading": "Made to be worn every day",
            "size": "h0"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Recycled gold and ethically sourced stones, finished by hand.</p>",
            "size": "large"
          }
        },
        "button": {
          "type": "button",
          "settings": {
            "label": "Shop the collection",
            "link": "shopify://collections/all",
            "style": "primary"
          }
        }
      },
      "block_order": ["heading", "text", "button"]
    }
  ]
}
{% endschema %}
