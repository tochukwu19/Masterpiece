{%- liquid
  assign cols = section.settings.columns_desktop
  assign cols_tablet = cols | at_most: 3
  assign cols_mobile = section.settings.columns_mobile | plus: 0
  assign vw_desktop = 100 | divided_by: cols
  assign vw_tablet = 100 | divided_by: cols_tablet
  assign vw_mobile = 100 | divided_by: cols_mobile
  capture card_sizes
    echo '(min-width: 990px) ' | append: vw_desktop | append: 'vw, (min-width: 750px) ' | append: vw_tablet | append: 'vw, ' | append: vw_mobile | append: 'vw'
  endcapture
  assign carousel = false
  if section.settings.layout == 'carousel'
    assign carousel = true
  endif
  assign view_all_url = blank
  assign view_all_label = blank
  if section.settings.show_view_all and section.settings.blog != blank
    assign view_all_url = section.settings.blog.url
    assign view_all_label = 'general.view_all' | t
  endif
-%}

<div
  class="blog-posts section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      size: section.settings.heading_size,
      link_url: view_all_url,
      link_label: view_all_label
    -%}

    <div
      class="{% if carousel %}carousel carousel--peek{% endif %}"
      style="--cols: {{ cols }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: {{ cols_mobile }};"
      {% if carousel %}
        x-data="carousel"
      {% endif %}
    >
      <ul
        class="{% if carousel %}carousel__track{% else %}layout-grid{% endif %} list-unstyled"
        role="list"
        {% if carousel %}
          data-carousel-track x-on:scroll.debounce.80ms="sync()"
        {% endif %}
      >

        {%- for article in section.settings.blog.articles limit: section.settings.post_count -%}
          <li>
            {%- render 'card-article',
              article: article,
              sizes: card_sizes,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_excerpt: section.settings.show_excerpt
            -%}
          </li>
        {%- else -%}
          {%- for i in (1..section.settings.post_count) -%}
            <li>{% render 'card-placeholder', type: 'article', index: i %}</li>
          {%- endfor -%}
        {%- endfor -%}
      </ul>
      {%- if carousel -%}
        {%- render 'carousel-controls' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Journal",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "From the journal",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:sections.blog_posts.settings.blog.label"
    },
    {
      "type": "range",
      "id": "post_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 3,
      "label": "t:sections.blog_posts.settings.post_count.label"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "t:sections.blog_posts.settings.show_date.label"
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "default": false,
      "label": "t:sections.blog_posts.settings.show_author.label"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": true,
      "label": "t:sections.blog_posts.settings.show_excerpt.label"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": true,
      "label": "t:sections.featured_collection.settings.show_view_all.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.header"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.all.layout.options__2.label"
        }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.main_collection.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_collection.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.presets.name"
    }
  ]
}
{% endschema %}
