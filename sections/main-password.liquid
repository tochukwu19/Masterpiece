<div class="password color-{{ section.settings.color_scheme.id }}">
  <div class="password__inner page-width page-width--narrow">
    <header class="password__brand">
      {%- if settings.logo -%}
        <h1 class="password__logo" style="--logo-width: {{ settings.logo_width }}px;">
          {%- render 'image', image: settings.logo, sizes: '300px', widths: '150, 300, 450, 600', eager: true, alt: shop.name -%}
        </h1>
      {%- else -%}
        <h1 class="password__wordmark h0">{{ shop.name }}</h1>
      {%- endif -%}
    </header>

    {%- if shop.password_message != blank -%}
      <p class="password__message h4">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      <div class="password__newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="eyebrow">{{ section.settings.newsletter_heading }}</h2>
        {%- endif -%}
        {%- form 'customer', id: 'PasswordNewsletterForm', class: 'password__form' -%}
          <input type="hidden" name="contact[tags]" value="prospect,password page">
          {%- if form.posted_successfully? -%}
            <p class="form-message" role="status">
              {%- render 'icon', name: 'check' -%}
              {{ 'newsletter.success' | t }}
            </p>
          {%- else -%}
            <div class="field">
              <label class="visually-hidden" for="PasswordNewsletter-email">{{ 'newsletter.label' | t }}</label>
              <div class="field__inline">
                <input
                  id="PasswordNewsletter-email"
                  class="input input--underline"
                  type="email"
                  name="contact[email]"
                  autocomplete="email"
                  autocorrect="off"
                  autocapitalize="off"
                  placeholder="{{ 'newsletter.placeholder' | t }}"
                  required
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="PasswordNewsletter-error"
                  {% endif %}
                >
                <button type="submit" class="icon-button field__inline-button">
                  {%- render 'icon', name: 'arrow-right' -%}
                  <span class="visually-hidden">{{ 'newsletter.button_label' | t }}</span>
                </button>
              </div>
              {%- if form.errors -%}
                <p class="form-message form-message--error" id="PasswordNewsletter-error">
                  {%- render 'icon', name: 'error' -%}
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    {%- form 'storefront_password', id: 'StorefrontPasswordForm', class: 'password__entry' -%}
      <details {% if form.errors %}open{% endif %}>
        <summary class="button button--tertiary">{{ 'password.enter_using_password' | t }}</summary>
        <div class="field password__form">
          <label class="field__label" for="StorefrontPassword">{{ 'password.label' | t }}</label>
          <div class="field__inline">
            <input
              id="StorefrontPassword"
              class="input"
              type="password"
              name="password"
              autocomplete="current-password"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="StorefrontPassword-error"
              {% endif %}
            >
            <button type="submit" class="icon-button field__inline-button">
              {%- render 'icon', name: 'arrow-right' -%}
              <span class="visually-hidden">{{ 'password.submit' | t }}</span>
            </button>
          </div>
          {%- if form.errors -%}
            <p class="form-message form-message--error" id="StorefrontPassword-error" role="alert">
              {%- render 'icon', name: 'error' -%}
              {{ 'password.error' | t }}
            </p>
          {%- endif -%}
        </div>
      </details>
    {%- endform -%}

    <footer class="password__footer text-small text-muted">
      {{ powered_by_link }}
    </footer>
  </div>
</div>

{% stylesheet %}
  .password {
    display: flex;
    min-height: 100svh;
    align-items: center;
  }

  .password__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    justify-items: center;
    padding-block: clamp(3rem, 8vw, 6rem);
    text-align: center;
  }

  .password__logo img {
    width: var(--logo-width);
    height: auto;
  }

  .password__wordmark {
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .password__message {
    max-width: 32rem;
  }

  .password__newsletter,
  .password__entry {
    display: grid;
    gap: 1rem;
    width: min(100%, 26rem);
  }

  .password__entry details {
    display: grid;
    gap: 1rem;
  }

  .password__entry summary {
    justify-self: center;
    list-style: none;
  }

  .password__entry summary::-webkit-details-marker {
    display: none;
  }

  .password__form {
    text-align: left;
  }

  .password__footer a {
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "section-main-password",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-2"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "default": true,
      "label": "t:sections.main_password.settings.show_newsletter.label"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Be the first to know",
      "label": "t:sections.main_password.settings.newsletter_heading.label"
    }
  ]
}
{% endschema %}
