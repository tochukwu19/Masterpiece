<div
  class="main-404 section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="main-404__inner page-width">
    <p class="main-404__code eyebrow text-muted">{{ 'general.404.code' | t }}</p>
    <h1 class="main-404__title {{ section.settings.heading_size }}">{{ 'general.404.title' | t }}</h1>
    <p class="main-404__text text-muted">{{ 'general.404.subtext' | t }}</p>

    {%- if section.settings.show_search -%}
      <div class="main-404__search">
        {%- render 'search-form', id: 'NotFoundSearch' -%}
      </div>
    {%- endif -%}

    <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'general.404.link' | t }}</a>
  </div>
</div>

{% stylesheet %}
  .main-404__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .main-404__title {
    max-width: 48rem;
  }

  .main-404__text {
    max-width: 32rem;
  }

  .main-404__search {
    width: min(100%, 32rem);
    margin-block: 1rem;
    text-align: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_404.name",
  "class": "section-main-404",
  "settings": [
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h0"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "default": true,
      "label": "t:sections.main_404.settings.show_search.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 120,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "enabled_on": {
    "templates": ["404"]
  }
}
{% endschema %}
