{% style %}
  .product-recommendations .grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  @media (min-width: 750px) {
    .product-recommendations .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstyle %}

{% if section.settings.show_recommendations %}
  <div class="w-[95%] mx-auto product-recommendations mt-16 mb-8" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related">
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      <div class="w-full my-4 flex flex-col justify-start">
        <p class="w-[90%] md:w-[20%] uppercase font-[500] text-sm md:text-base">
          See Related items
        </p>
        <h2 class="w-[90%] calvino font-[500] text-[50px] md:text-[100px]">
          You may also like
        </h2>
      </div>

      <div class="w-full mx-auto grid gap-8">
        {% for product in recommendations.products %}
          {% render 'card-product', product: product, id_prefix: section.id %}
        {% else %}
          <p>No products found.</p>
        {% endfor %}
      </div>
    {%- endif -%}
  </div>
{% endif %}


<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('.product-recommendations');
    if (!container) return;

    const observer = new IntersectionObserver((entries) => {
      if (!entries[0].isIntersecting) return;
      observer.disconnect();
      fetch(container.dataset.url)
        .then((response) => response.text())
        .then((text) => {
          const incoming = theme.parseHTML(text).querySelector('.product-recommendations');
          if (incoming && incoming.innerHTML.trim().length) container.innerHTML = incoming.innerHTML;
        })
        .catch((error) => console.error(error));
    }, { rootMargin: '0px 0px 200px 0px' });

    observer.observe(container);
  });
</script>

{% schema %}
  {
    "name": "Related products",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_recommendations",
        "label": "Show recommendations",
        "default": true
      }
    ]
  }
{% endschema %}