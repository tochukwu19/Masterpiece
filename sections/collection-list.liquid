{%- liquid
  assign cols = section.settings.columns_desktop
  assign cols_tablet = cols | at_most: 3
  assign cols_mobile = section.settings.columns_mobile | plus: 0
  assign vw_desktop = 100 | divided_by: cols
  assign vw_tablet = 100 | divided_by: cols_tablet
  assign vw_mobile = 100 | divided_by: cols_mobile
  capture card_sizes
    echo '(min-width: 990px) ' | append: vw_desktop | append: 'vw, (min-width: 750px) ' | append: vw_tablet | append: 'vw, ' | append: vw_mobile | append: 'vw'
  endcapture
  assign carousel = false
  if section.settings.layout == 'carousel'
    assign carousel = true
  endif
-%}

<div
  class="collection-list section color-{{ section.settings.color_scheme.id }}"
  style="--section-pt: {{ section.settings.padding_top }}px; --section-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="page-width">
    {%- render 'section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      size: section.settings.heading_size
    -%}

    <div
      class="{% if carousel %}carousel carousel--peek{% endif %}"
      style="--cols: {{ cols }}; --cols-tablet: {{ cols_tablet }}; --cols-mobile: {{ cols_mobile }};"
      {% if carousel %}
        x-data="carousel"
      {% endif %}
    >
      <ul
        class="{% if carousel %}carousel__track{% else %}layout-grid{% endif %} list-unstyled"
        role="list"
        {% if carousel %}
          data-carousel-track x-on:scroll.debounce.80ms="sync()"
        {% endif %}
      >

        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {%- if block.settings.collection != blank -%}
              {%- render 'card-collection',
                collection: block.settings.collection,
                ratio: section.settings.image_ratio,
                sizes: card_sizes,
                show_count: section.settings.show_product_count
              -%}
            {%- else -%}
              {%- render 'card-placeholder', type: 'collection', index: forloop.index, ratio: section.settings.image_ratio -%}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if carousel -%}
        {%- render 'carousel-controls' -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection_list.name",
  "class": "section-collection-list",
  "max_blocks": 12,
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_list.blocks.collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.featured_collection.settings.collection.label"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Shop by category",
      "label": "t:sections.all.eyebrow.label"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Collections",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:sections.all.heading_size.label",
      "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.main_list_collections.settings.image_ratio.label",
      "options": [
        {
          "value": "4 / 5",
          "label": "t:sections.main_list_collections.settings.image_ratio.options__1.label"
        },
        {
          "value": "1 / 1",
          "label": "t:sections.main_list_collections.settings.image_ratio.options__2.label"
        },
        {
          "value": "3 / 2",
          "label": "t:sections.main_list_collections.settings.image_ratio.options__3.label"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "default": false,
      "label": "t:sections.main_list_collections.settings.show_product_count.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.layout.header"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.all.layout.label",
      "options": [
        {
          "value": "grid",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "carousel",
          "label": "t:sections.all.layout.options__2.label"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3,
      "label": "t:sections.main_collection.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.main_collection.settings.columns_mobile.label",
      "options": [
        {
          "value": "1",
          "label": "t:sections.main_collection.settings.columns_mobile.options__1.label"
        },
        {
          "value": "2",
          "label": "t:sections.main_collection.settings.columns_mobile.options__2.label"
        }
      ],
      "default": "1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.header"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64,
      "label": "t:sections.all.padding.padding_bottom"
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_list.presets.name",
      "blocks": {
        "c1": {
          "type": "collection"
        },
        "c2": {
          "type": "collection"
        },
        "c3": {
          "type": "collection"
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3"
      ]
    }
  ]
}
{% endschema %}
